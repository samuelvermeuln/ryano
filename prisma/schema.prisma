generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolJoinPolicy {
  AUTO_APPROVE
  REQUIRE_APPROVAL
  INVITE_ONLY
}

enum CoachSelectionPolicy {
  ATHLETE_CHOOSES
  ADMIN_ASSIGNS
  AUTO_LOBBY
  INVITE_DEFINES_COACH
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  ENDED
}

enum CoachStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  ENDED
}

enum InvitationType {
  SCHOOL
  SCHOOL_COACH
  COACH
}

enum InvitationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  EXHAUSTED
}

enum InvitationUseResult {
  PENDING_APPROVAL
  JOINED
  REJECTED
  FAILED
}

enum HistoryGranteeType {
  SCHOOL
  COACH
}

enum HistoryGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum WorkoutOwnerType {
  COACH
  SCHOOL
  SYSTEM
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkoutStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WorkoutBlockType {
  WARMUP
  INTERVAL
  STEADY
  RECOVERY
  COOLDOWN
  DRILL
  FREE
  CUSTOM
}

// School-scoped roles are independent of the global authentication Role.
enum SchoolRole {
  OWNER
  ADMIN
  COACH
  ASSISTANT_COACH
  STAFF
  ATHLETE
  GUARDIAN
}

model School {
  id                   String                    @id @default(cuid())
  slug                 String                    @unique @db.VarChar(100)
  name                 String                    @db.VarChar(200)
  description          String?
  logoUrl              String?
  ownerUserId          String
  owner                User                      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  status               SchoolStatus              @default(ACTIVE)
  joinPolicy           SchoolJoinPolicy          @default(REQUIRE_APPROVAL)
  coachSelectionPolicy CoachSelectionPolicy      @default(ADMIN_ASSIGNS)
  // Dados cadastrais da escola
  email                String?                   @db.VarChar(254)
  phoneE164            String?                   @db.VarChar(20)
  cnpjEncrypted        String?
  cnpjHash             String?                   @unique @db.VarChar(64)
  // Endereço da escola
  postalCode           String?                   @db.VarChar(10)
  street               String?                   @db.VarChar(300)
  addressNumber        String?                   @db.VarChar(20)
  complement           String?                   @db.VarChar(100)
  district             String?                   @db.VarChar(100)
  city                 String?                   @db.VarChar(100)
  state                String?                   @db.VarChar(2)
  country              String?                   @db.VarChar(60)
  // Modalidades atendidas (array de RyvanoSportType)
  sportTypes           String[]
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  deactivatedAt        DateTime?                 @db.Timestamptz(3)
  archivedAt           DateTime?                 @db.Timestamptz(3)
  memberships          SchoolMembership[]
  coachMemberships     CoachSchoolMembership[]
  athleteMemberships   SchoolAthleteMembership[]
  coachAssignments     CoachAthleteAssignment[]
  invitationLinks      InvitationLink[]
  historyAccessGrants  HistoryAccessGrant[]
  workoutTemplates     WorkoutTemplate[]
  originWorkouts       Workout[]                 @relation("WorkoutOriginSchool")
  assignments          WorkoutAssignment[]
  teams                Team[]
  trainingProducts     TrainingProduct[]
  workoutRequests      WorkoutRequest[]
  /// TM008 — engagements where this school is the acting coach's school context.
  licenseCoachEngagements LicenseCoachEngagement[]

  @@index([ownerUserId, status])
  @@index([status, name, id])
}

enum Role {
  USER
  ADMIN
}

enum AvatarSource {
  CUSTOM
  GOOGLE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum WearableProvider {
  GARMIN
  STRAVA
  APPLE
  POLAR
  COROS
  SUUNTO
  FITBIT
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  SYNCING
  ERROR
  RECONNECT_REQUIRED
}

enum SecretType {
  GARMIN_EMAIL
  GARMIN_PASSWORD
  GARMIN_API_KEY
  STRAVA_ACCESS_TOKEN
  STRAVA_REFRESH_TOKEN
}

enum Channel {
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model User {
  id                       String                     @id @default(cuid())
  name                     String?
  email                    String                     @unique
  emailVerified            DateTime?
  image                    String?
  avatarSource             AvatarSource?
  role                     Role                       @default(USER)
  status                   UserStatus                 @default(PENDING)
  passwordHash             String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  profile                  UserProfile?
  address                  Address?
  wearableConnections      WearableConnection[]
  activities               Activity[]
  whatsappIdentity         WhatsAppIdentity?
  notificationPreference   NotificationPreference?
  activationTokens         WhatsAppActivationToken[]
  messageDeliveries        MessageDelivery[]
  integrationEvents        IntegrationEvent[]
  auditLogs                AdminAuditLog[]            @relation("AdminAuditActor")
  passwordResetTokens      PasswordResetToken[]
  ownedSchools             School[]
  schoolMemberships        SchoolMembership[]
  athleteMemberships       SchoolAthleteMembership[]
  coachProfile             CoachProfile?
  coachAssignments         CoachAthleteAssignment[]
  createdInvitationLinks   InvitationLink[]
  invitationUses           InvitationUse[]            @relation("InvitationUseActor")
  athleteInvitationUses    InvitationUse[]            @relation("InvitationUseAthlete")
  grantedHistoryAccesses   HistoryAccessGrant[]       @relation("HistoryGrantGrantedBy")
  revokedHistoryAccesses   HistoryAccessGrant[]       @relation("HistoryGrantRevokedBy")
  historyAccessGrants      HistoryAccessGrant[]
  assignedWorkouts         WorkoutAssignment[]        @relation("WorkoutAssignmentAthlete")
  assignedWorkoutsBy       WorkoutAssignment[]        @relation("WorkoutAssignmentAssigner")
  workoutAssignmentHistory WorkoutAssignmentHistory[] @relation("WorkoutAssignmentHistoryActor")

  teamAthletes      TeamAthlete[]      @relation("UserTeamAthlete")
  workoutExecutions WorkoutExecution[] @relation("WorkoutExecutionAthlete")
  trainingPurchases TrainingPurchase[] @relation("TrainingPurchaseAthlete")
  trainingLicenses  TrainingLicense[]  @relation("TrainingLicenseAthlete")
  /// TM008 — as the athlete who invited/authorized a coach to follow a license.
  licenseCoachEngagementsAsAthlete LicenseCoachEngagement[] @relation("LicenseCoachEngagementAthlete")
  /// TM008 — as the acting user who proposed a plan adaptation (mirrors the
  /// coach's CoachProfile, kept separately for a plain-User audit trail).
  planAdaptationsActed             PlanAdaptation[]         @relation("PlanAdaptationActor")
  /// TM009 — reviews this user left on purchased marketplace products.
  marketplaceReviews               MarketplaceReview[]      @relation("MarketplaceReviewAthlete")

  sentWorkoutRequests    WorkoutRequest[] @relation("WorkoutRequestAthlete")
  decidedWorkoutRequests WorkoutRequest[] @relation("WorkoutRequestDecider")
}

model CoachProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  displayName         String                   @db.VarChar
  bio                 String?                  @db.Text
  status              CoachStatus              @default(ACTIVE)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  schoolMemberships   CoachSchoolMembership[]
  athleteAssignments  CoachAthleteAssignment[]
  invitationLinks     InvitationLink[]
  historyAccessGrants HistoryAccessGrant[]
  workoutTemplates    WorkoutTemplate[]
  authoredWorkouts    Workout[]                @relation("WorkoutAuthorCoach")
  assignments         WorkoutAssignment[]      @relation("WorkoutAssignmentCoach")
  teamCoaches         TeamCoach[]
  coachEvaluations    CoachEvaluation[]
  trainingProducts    TrainingProduct[]
  /// TM007 — assignments this coach adjusted via a PlanAdaptation (design D-06).
  adjustedAssignments WorkoutAssignment[]      @relation("WorkoutAssignmentAdjustedBy")
  /// TM008 — licenses (of athletes who are not necessarily this coach's own
  /// students) this coach was authorized to follow.
  licenseEngagements  LicenseCoachEngagement[] @relation("LicenseCoachEngagementCoach")
  planAdaptations     PlanAdaptation[]         @relation("PlanAdaptationCoach")
}

/// Reusable library entry. Owner identity is polymorphic to retain SYSTEM support.
model WorkoutTemplate {
  id            String           @id @default(cuid())
  ownerType     WorkoutOwnerType
  ownerId       String
  authorCoachId String?
  schoolId      String?
  title         String           @db.VarChar(200)
  description   String?          @db.Text
  sportType     String           @db.VarChar(100)
  version       Int
  status        TemplateStatus   @default(DRAFT)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  authorCoach         CoachProfile?      @relation(fields: [authorCoachId], references: [id], onDelete: Restrict)
  school              School?            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  workouts            Workout[]
  workoutAssignments  WorkoutAssignment[]

  @@index([ownerType, ownerId, status, updatedAt, id])
  @@index([authorCoachId, status])
  @@index([schoolId, status])
}

/// A concrete prescription holds a self-contained snapshot, never a live template view.
model Workout {
  id               String              @id @default(cuid())
  templateId       String?
  templateVersion  Int?
  authorCoachId    String?
  originSchoolId   String?
  title            String              @db.VarChar(200)
  description      String?             @db.Text
  sportType        String              @db.VarChar(100)
  scheduledDate    DateTime?           @db.Date
  scheduledStartAt DateTime?           @db.Timestamptz(3)
  status           WorkoutStatus       @default(DRAFT)
  snapshotPayload  Json
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  template         WorkoutTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  authorCoach      CoachProfile?       @relation("WorkoutAuthorCoach", fields: [authorCoachId], references: [id], onDelete: Restrict)
  originSchool     School?             @relation("WorkoutOriginSchool", fields: [originSchoolId], references: [id], onDelete: Restrict)
  blocks           WorkoutBlock[]
  assignments      WorkoutAssignment[]

  @@index([templateId, templateVersion])
  @@index([authorCoachId, status, createdAt, id])
  @@index([originSchoolId, status, scheduledDate, id])
}

/// Normalized blocks are an optional query aid; the immutable snapshot is authoritative.
model WorkoutBlock {
  id            String           @id @default(cuid())
  workoutId     String
  position      Int
  blockType     WorkoutBlockType
  title         String?          @db.VarChar(200)
  distanceM     Decimal?         @db.Decimal(12, 2)
  durationS     Int?
  repetitions   Int?
  targetPayload Json?
  restPayload   Json?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  workout       Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, position])
  @@index([workoutId, position])
}

/// Scope, usage limits and terminal-status checks are enforced in migration 0017.
/// Only the token hash is persisted; never store or log the public bearer token.
model InvitationLink {
  id               String           @id @default(cuid())
  tokenHash        String           @unique @db.VarChar
  type             InvitationType
  schoolId         String?
  coachId          String?
  createdBy        String
  requiresApproval Boolean
  expiresAt        DateTime?        @db.Timestamptz(3)
  maxUses          Int?
  usedCount        Int              @default(0)
  status           InvitationStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  revokedAt        DateTime?        @db.Timestamptz(3)
  school           School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach            CoachProfile?    @relation(fields: [coachId], references: [id], onDelete: Restrict)
  creator          User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  uses             InvitationUse[]

  @@index([schoolId, status])
  @@index([coachId, status])
  @@index([createdBy])
  @@index([status, expiresAt])
}

/// Audit events may repeat for the same actor and invitation; acceptance owns retry idempotency.
model InvitationUse {
  id           String              @id @default(cuid())
  invitationId String
  userId       String
  athleteId    String?
  usedAt       DateTime            @default(now()) @db.Timestamptz(3)
  result       InvitationUseResult
  invitation   InvitationLink      @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  user         User                @relation("InvitationUseActor", fields: [userId], references: [id], onDelete: Restrict)
  athlete      User?               @relation("InvitationUseAthlete", fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([invitationId, usedAt, id])
  @@index([userId, usedAt, id])
  @@index([athleteId, usedAt, id])
  // T316: replay check in AcceptInvitation: WHERE invitationId = ? AND userId = ?
  @@index([invitationId, userId])
}

/// Athlete-owned access grants preserve source data while allowing revocable reads.
model HistoryAccessGrant {
  id          String             @id @default(cuid())
  athleteId   String
  granteeType HistoryGranteeType
  granteeId   String
  schoolId    String?
  coachId     String?
  scope       Json
  fromDate    DateTime?          @db.Date
  toDate      DateTime?          @db.Date
  status      HistoryGrantStatus @default(ACTIVE)
  grantedBy   String
  grantedAt   DateTime           @default(now()) @db.Timestamptz(3)
  revokedBy   String?
  revokedAt   DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  athlete     User               @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  school      School?            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach       CoachProfile?      @relation(fields: [coachId], references: [id], onDelete: Restrict)
  grantor     User               @relation("HistoryGrantGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  revoker     User?              @relation("HistoryGrantRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([athleteId, status, grantedAt, id])
  @@index([granteeType, granteeId, status])
  @@index([schoolId, status])
  @@index([coachId, status])
}

/// Primary ACTIVE uniqueness per school and PENDING startedAt NULL are enforced in migration 0016.
model CoachAthleteAssignment {
  id         String           @id @default(cuid())
  athleteId  String
  coachId    String
  schoolId   String?
  status     AssignmentStatus @default(PENDING)
  isPrimary  Boolean          @default(true)
  sportType  String?          @db.VarChar
  startedAt  DateTime?        @db.Timestamptz(3)
  endedAt    DateTime?        @db.Timestamptz(3)
  assignedBy String?
  endedBy    String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  athlete    User             @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  coach      CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  school     School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, athleteId, status])
  @@index([coachId, status])
}

/// Active pair uniqueness and PENDING startedAt NULL are enforced in migration 0014.
model CoachSchoolMembership {
  id          String           @id @default(cuid())
  coachId     String
  schoolId    String
  status      MembershipStatus @default(PENDING)
  requestedAt DateTime         @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?        @db.Timestamptz(3)
  startedAt   DateTime?        @db.Timestamptz(3)
  endedAt     DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  coach       CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([coachId, status])
}

enum MembershipJoinSource {
  SCHOOL_INVITE
  SCHOOL_COACH_INVITE
  COACH_INVITE
  MANUAL_SEARCH
  ADMIN_CREATED
  MIGRATION
}

/// Active pair uniqueness and PENDING startedAt NULL are enforced in migration 0015.
model SchoolAthleteMembership {
  id         String               @id @default(cuid())
  schoolId   String
  athleteId  String
  status     MembershipStatus     @default(PENDING)
  joinSource MembershipJoinSource
  approvedBy String?
  approvedAt DateTime?            @db.Timestamptz(3)
  rejectedBy String?
  rejectedAt DateTime?            @db.Timestamptz(3)
  revokedBy  String?
  revokedAt  DateTime?            @db.Timestamptz(3)
  startedAt  DateTime?            @db.Timestamptz(3)
  endedAt    DateTime?            @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)
  school     School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  athlete    User                 @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([athleteId, status])
}

/// PENDING requires startedAt NULL, enforced by the CHECK in migration 0011.
model SchoolMembership {
  id        String                 @id @default(cuid())
  schoolId  String
  userId    String
  status    MembershipStatus       @default(PENDING)
  startedAt DateTime?              @db.Timestamptz(3)
  endedAt   DateTime?              @db.Timestamptz(3)
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @db.Timestamptz(3)
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles     SchoolMembershipRole[]

  @@index([schoolId, status])
  @@index([userId, status])
}

model SchoolMembershipRole {
  id           String           @id @default(cuid())
  membershipId String
  role         SchoolRole
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  membership   SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([membershipId, role])
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  cpfEncrypted            String?
  cpfHash                 String?   @unique
  phoneE164               String?
  heightCm                Int?
  weightKg                Decimal?  @db.Decimal(5, 2)
  onboardingCompletedAt   DateTime?
  activityLayoutOrder     Json?
  dashboardLayoutOrder    Json?
  integrationsLayoutOrder Json?
  /// TM050 — one dedicated column per `CustomizableCardGrid` surface, same
  /// convention as the three above (never a shared/generic key — that would
  /// let unrelated surfaces overwrite each other's saved order).
  marketplaceCatalogLayoutOrder Json?
  athletePlanLayoutOrder        Json?
  coachStudioLayoutOrder        Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(cuid())
  userId     String   @unique
  postalCode String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WearableConnection {
  id                         String                   @id @default(cuid())
  userId                     String
  provider                   WearableProvider
  externalAccountId          String?
  status                     ConnectionStatus         @default(DISCONNECTED)
  capabilities               String[]
  label                      String?
  lastSyncAt                 DateTime?
  lastSyncStatus             String?
  lastErrorCode              String?
  lastProbeAt                DateTime?
  nextProbeAt                DateTime?
  lastSeenActivityExternalId String?
  lastProbeStatus            String?
  lastProbeErrorCode         String?
  lastProbeFailureCount      Int                      @default(0)
  lastEventAt                DateTime?
  lastSuccessAt              DateTime?
  lastErrorAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secrets                    WearableSecret[]
  activities                 Activity[]
  stravaDetails              StravaConnectionDetails?

  @@unique([userId, provider])
  @@index([provider, nextProbeAt])
}

model WearableSecret {
  id                   String             @id @default(cuid())
  wearableConnectionId String
  secretType           SecretType
  ciphertext           String
  nonce                String
  authTag              String
  keyVersion           Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)

  @@unique([wearableConnectionId, secretType])
}

model Activity {
  id                   String             @id @default(cuid())
  userId               String
  wearableConnectionId String
  externalId           String
  provider             WearableProvider
  sportType            String
  providerSportType    String?
  name                 String?
  startedAt            DateTime
  endedAt              DateTime?
  durationSeconds      Int?
  movingSeconds        Int?
  distanceMeters       Float?
  calories             Int?
  averageHeartRate     Int?
  maxHeartRate         Int?
  averagePace          Float?
  averageSpeed         Float?
  maxSpeed             Float?
  elevationGain        Float?
  averageCadence       Float?
  averagePower         Float?
  maxPower             Float?
  timezone             String?
  metrics              Json?
  rawPayload           Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, userId])
  @@index([userId, startedAt])
}

model WhatsAppIdentity {
  id          String    @id @default(cuid())
  userId      String    @unique
  phoneE164   String
  externalJid String?
  verifiedAt  DateTime?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsAppActivationToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  phoneE164    String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  postActivityReport Boolean  @default(true)
  dailySummary       Boolean  @default(false)
  weeklySummary      Boolean  @default(false)
  reportTime         String?
  timezone           String?  @default("America/Sao_Paulo")
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageDelivery {
  id                String         @id @default(cuid())
  userId            String
  channel           Channel
  type              String
  provider          String
  externalMessageId String?
  status            DeliveryStatus @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorCode         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model IntegrationEvent {
  id          String    @id @default(cuid())
  userId      String?
  provider    String
  eventType   String
  externalId  String?
  payload     Json?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, eventType, externalId])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  scope     String
  key       String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([resetAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String
  targetUserId String?
  entityType   String?
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  // T316: audit queries are scoped to actor or entity
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Strava-specific models
// Provider-specific persistence for the modular Strava integration. Canonical
// activities live in the shared `Activity` model; the models below hold data
// that only makes sense for Strava (OAuth connection details, webhook lifecycle
// and short-lived caches).
// Note: StravaStreamCache is intentionally deferred — it will only be added if
// activity streams turn out to be necessary (see design section 3).
// ---------------------------------------------------------------------------

model StravaConnectionDetails {
  id                   String             @id @default(cuid())
  wearableConnectionId String             @unique
  athleteId            String             @unique
  scopes               String[]
  accessTokenExpiresAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)
}

model StravaWebhookSubscription {
  id                     String   @id @default(cuid())
  externalSubscriptionId String   @unique
  callbackUrl            String
  status                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model StravaWebhookEvent {
  id               String    @id @default(cuid())
  ownerAthleteId   String?
  objectType       String
  objectId         String
  aspectType       String
  eventTime        DateTime
  payload          Json?
  processingStatus String // PENDING | PROCESSED | FAILED
  attemptCount     Int       @default(0)
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  expiresAt        DateTime

  @@index([processingStatus, receivedAt])
  @@index([ownerAthleteId, receivedAt])
}

model StravaActivityCache {
  id                   String    @id @default(cuid())
  wearableConnectionId String
  stravaActivityId     String
  sportType            String?
  startedAt            DateTime?
  payload              Json
  fetchedAt            DateTime
  expiresAt            DateTime

  @@unique([wearableConnectionId, stravaActivityId])
  @@index([expiresAt])
}

model Team {
  id                 String              @id @default(cuid())
  schoolId           String
  name               String              @db.VarChar(200)
  /// Canonical RyvanoSportType.
  sportType          String?             @db.VarChar(100)
  level              String?             @db.VarChar(100)
  /// null = no declared limit. Enforced by the use case, not by the database:
  /// lowering capacity must not invalidate athletes already in the team.
  capacity           Int?
  location           String?             @db.VarChar(200)
  notes              String?             @db.VarChar(1000)
  archivedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  members            TeamAthlete[]
  coaches            TeamCoach[]
  workoutAssignments WorkoutAssignment[]

  @@index([schoolId, archivedAt])
  @@index([schoolId, sportType, archivedAt])
}

model TeamAthlete {
  id        String   @id @default(cuid())
  teamId    String
  athleteId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete   User     @relation("UserTeamAthlete", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([teamId, athleteId])
}

/// Explicit assignment of a coach to a team, allowing coaches to manage
/// specific teams rather than every team in their school.
model TeamCoach {
  id        String   @id @default(cuid())
  teamId    String
  coachId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([teamId, coachId])
  @@index([coachId])
}

model WorkoutAssignment {
  id          String                  @id @default(cuid())
  /// Null for template-based assignments (T406) where the Workout record is not yet resolved.
  workoutId   String?
  /// Null for template-based assignments instantiated by the license system (T406).
  workoutTemplateId String?
  athleteId   String
  /// Null for system-initiated assignments (e.g. license calendar instantiation).
  assignedBy  String?
  schoolId    String?
  coachId     String?
  teamId      String?
  scheduledAt DateTime?               @db.Timestamptz(3)
  dueAt       DateTime?               @db.Timestamptz(3)
  status      WorkoutAssignmentStatus @default(SCHEDULED)
  /// Match tracking (T210–T215)
  matchStatus      WorkoutMatchStatus?
  matchedActivityId String?
  matchedAt        DateTime?           @db.Timestamptz(3)
  matchScore       Float?
  /// Link back to the license that created this assignment (T406).
  trainingLicenseId String?
  /// TM007 — marketplace provenance (RF-110/RF-303). All nullable: additive,
  /// no effect on assignments that do not come from a license.
  planSessionId    String?
  /// Snapshot of the session as it existed in the purchased plan version,
  /// before any coach adaptation — kept so "originally prescribed" is always
  /// answerable even after `effectiveRevisionId` changes the live prescription.
  originalSnapshot Json?
  /// Current PlanAdaptation in effect for this assignment, if any (TM008).
  /// Left as a plain id (not a Prisma relation) here; TM008 upgrades it to a
  /// real FK once PlanAdaptation exists, to avoid a forward reference.
  effectiveRevisionId String?
  adjustedByCoachId   String?
  /// Display label for the calendar UI when workoutId is null, e.g. "Marketplace: Corrida 5km".
  sourceLabel         String? @db.VarChar(200)
  /// TM008 — optimistic-concurrency counter for PlanAdaptation proposals
  /// (RNF-003). Starts at 0; DecidePlanAdaptation (TM075) increments it when
  /// a proposal is accepted, so a second, now-stale proposal is rejected
  /// instead of silently overwriting the first.
  adaptationVersion   Int     @default(0)
  /// Garmin planned workout push tracking (Fase 5).
  garminWorkoutId   String?
  /// PENDING | PUSHED | FAILED
  garminPushStatus  String?
  garminPushedAt    DateTime?           @db.Timestamptz(3)
  garminPushError   String?
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)

  workout         Workout?                   @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  workoutTemplate WorkoutTemplate?           @relation(fields: [workoutTemplateId], references: [id], onDelete: Restrict)
  athlete         User                       @relation("WorkoutAssignmentAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  assigner        User?                      @relation("WorkoutAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)
  school          School?                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  // TM007 — named, because a second CoachProfile relation (adjustedByCoach)
  // was added below; Prisma requires every relation between the same pair
  // of models to be named once there is more than one.
  coach           CoachProfile?              @relation("WorkoutAssignmentCoach", fields: [coachId], references: [id], onDelete: Restrict)
  team            Team?                      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  trainingLicense TrainingLicense?           @relation(fields: [trainingLicenseId], references: [id], onDelete: SetNull)
  /// TM007 — which coach applied the currently-effective adaptation (RF-303/design D-06), if any.
  adjustedByCoach CoachProfile?              @relation("WorkoutAssignmentAdjustedBy", fields: [adjustedByCoachId], references: [id], onDelete: SetNull)
  history         WorkoutAssignmentHistory[]
  executions      WorkoutExecution[]
  compliances     WorkoutCompliance[]
  evaluations     CoachEvaluation[]
  feedbacks       AthleteFeedback[]
  /// Set when this assignment was created by approving a WorkoutRequest (at most one).
  originatingRequest WorkoutRequest?
  /// TM008 — proposed adaptations targeting this assignment (design D-06).
  planAdaptations PlanAdaptation[]

  @@index([athleteId, status, id])
  @@index([teamId, status])
  @@index([schoolId, status])
  @@index([coachId, status])
  @@index([trainingLicenseId])
  // T316: combined filter used in GET /api/workout-assignments (schoolId + athleteId + status + cursor)
  @@index([schoolId, athleteId, status, id])
}

model WorkoutAssignmentHistory {
  id                  String   @id @default(cuid())
  workoutAssignmentId String
  eventType           String   @db.VarChar(100)
  actorUserId         String
  payload             Json
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  workoutAssignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)
  actor             User              @relation("WorkoutAssignmentHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([workoutAssignmentId, createdAt])
}

enum WorkoutRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// Athlete-initiated request for a coach to prescribe a workout.
/// resultingAssignmentId is set only on approval — one request maps to at most
/// one resulting WorkoutAssignment (enforced by the @unique below).
model WorkoutRequest {
  id                    String               @id @default(cuid())
  athleteId             String
  schoolId              String
  sportType             String               @db.VarChar(100)
  preferredDate         DateTime?            @db.Date
  note                  String?              @db.Text
  status                WorkoutRequestStatus @default(PENDING)
  decidedBy             String?
  decidedAt             DateTime?            @db.Timestamptz(3)
  declineReason         String?              @db.Text
  resultingAssignmentId String?              @unique
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  athlete             User               @relation("WorkoutRequestAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  decider             User?              @relation("WorkoutRequestDecider", fields: [decidedBy], references: [id], onDelete: Restrict)
  resultingAssignment WorkoutAssignment? @relation(fields: [resultingAssignmentId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([athleteId, status])
}

enum WorkoutAssignmentStatus {
  SCHEDULED
  AVAILABLE
  COMPLETED
  PARTIALLY_COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
  JUSTIFIED
  UNPLANNED
}

/// Records the execution of a prescribed workout, matched to a provider activity.
/// matchStatus drives the reconciliation lifecycle:
///   PENDING      — activity ingested; automatic matching in progress
///   AUTO_MATCHED — system found a confident match (score ≥ threshold)
///   CONFIRMED    — athlete or coach confirmed the auto-match
///   OVERRIDDEN   — user chose a different activity than the auto-match
///   NO_MATCH     — matching ran and found no suitable candidate
model WorkoutExecution {
  id                   String               @id @default(cuid())
  workoutAssignmentId  String
  athleteId            String
  /// Provider that supplied the activity (e.g. "strava", "garmin").
  source               String               @db.VarChar(50)
  /// Activity identifier in the provider's system.
  externalId           String               @db.VarChar(256)
  sportType            String               @db.VarChar(100)
  startedAt            DateTime             @db.Timestamptz(3)
  durationSeconds      Int?
  movingSeconds        Int?
  distanceMeters       Float?
  averageHeartRate     Int?
  maxHeartRate         Int?
  averageSpeed         Float?
  elevationGain        Float?
  averagePower         Int?
  /// Composite 0–100 match score computed by WorkoutMatchingService.
  matchScore           Int
  matchStatus          WorkoutMatchStatus   @default(PENDING)
  /// Snapshot of the raw provider activity payload for audit and re-scoring.
  activityPayload      Json
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  assignment   WorkoutAssignment  @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)
  athlete      User               @relation("WorkoutExecutionAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  compliance   WorkoutCompliance?
  evaluations  CoachEvaluation[]
  feedback     AthleteFeedback?

  @@unique([workoutAssignmentId, source, externalId])
  @@index([athleteId, startedAt])
  @@index([workoutAssignmentId, matchStatus])
  // T316: ordered listing in GET /api/workout-assignments/[id]/executions
  @@index([workoutAssignmentId, createdAt(sort: Desc)])
}

enum WorkoutMatchStatus {
  PENDING
  AUTO_MATCHED
  CONFIRMED
  OVERRIDDEN
  NO_MATCH
}

// ---------------------------------------------------------------------------
// T220 — CoachEvaluation
// ---------------------------------------------------------------------------

model CoachEvaluation {
  id                   String   @id @default(cuid())
  workoutExecutionId   String
  workoutAssignmentId  String
  athleteId            String
  coachId              String
  schoolId             String
  /// 0–100 integer (displayed as 0.0–10.0 by dividing by 10).
  overallScore         Int
  note                 String?  @db.VarChar(5000)
  isVisible            Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  execution  WorkoutExecution  @relation(fields: [workoutExecutionId], references: [id], onDelete: Cascade)
  assignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)
  coach      CoachProfile      @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@unique([workoutExecutionId, coachId])
  @@index([workoutAssignmentId])
  @@index([athleteId])
  // T316: athlete-scoped evaluation listing filters on (executionId, isVisible)
  @@index([workoutExecutionId, isVisible])
}

// ---------------------------------------------------------------------------
// T221 — AthleteFeedback
// ---------------------------------------------------------------------------

model AthleteFeedback {
  id                   String   @id @default(cuid())
  workoutExecutionId   String   @unique
  workoutAssignmentId  String
  athleteId            String
  /// Rated Perceived Exertion 1–10.
  rpe                  Int
  /// Subjective mood 1–5 (optional).
  mood                 Int?
  /// Subjective energy level 1–5 (optional).
  energy               Int?
  comment              String?  @db.VarChar(2000)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  execution  WorkoutExecution  @relation(fields: [workoutExecutionId], references: [id], onDelete: Cascade)
  assignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)

  @@index([workoutAssignmentId])
  @@index([athleteId])
}

// ---------------------------------------------------------------------------
// T240 — SchoolAuditLog
// ---------------------------------------------------------------------------

/// Append-only audit trail for school-module operations. Never update or delete rows.
model SchoolAuditLog {
  id           String   @id @default(cuid())
  schoolId     String
  actorUserId  String?
  action       String   @db.VarChar(100)
  entityType   String   @db.VarChar(100)
  entityId     String
  metadata     Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, schoolId])
}

// ---------------------------------------------------------------------------
// T190 — WorkoutCompliance
// ---------------------------------------------------------------------------

model WorkoutCompliance {
  id                   String   @id @default(cuid())
  workoutExecutionId   String   @unique
  workoutAssignmentId  String
  athleteId            String
  /// Weighted compliance score 0–100.
  overallScore         Int
  /// Per-dimension scores as JSON: { distance?, duration?, pace?, heartRate?, power?, intervals?, rest?, zones? }
  breakdown            Json
  /// Which ComplianceStrategy was used (e.g. "run", "swim", "default").
  strategyKey          String   @db.VarChar(50)
  /// Monotonic version of the compliance algorithm (T206).
  algorithmVersion     Int
  calculatedAt         DateTime @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  execution  WorkoutExecution  @relation(fields: [workoutExecutionId], references: [id], onDelete: Cascade)
  assignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)

  @@index([workoutAssignmentId])
  @@index([athleteId])
  // T316: compliance timeline listing ordered by most recent
  @@index([athleteId, calculatedAt(sort: Desc)])
}

// =============================================================================
// FASE 18 — TrainingProduct marketplace (T400–T403)
// =============================================================================

/// Lifecycle of a training plan product published by a coach or school.
enum TrainingProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Who may purchase/access the product.
enum TrainingProductVisibility {
  PUBLIC
  UNLISTED
  SCHOOL_ONLY
}

/// Terminal states for a purchase.
enum TrainingPurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

/// Activation state for a license instance assigned to one athlete.
/// TM006 — PAUSED/COMPLETED added: `/app/planos` (spec §5) needs to tell
/// "paused by the athlete" and "finished the plan" apart from ACTIVE.
enum TrainingLicenseStatus {
  ACTIVE
  PAUSED
  COMPLETED
  EXPIRED
  REVOKED
}

/// TM006 — how the athlete chose to anchor week 1 / day 1 of the plan.
enum TrainingLicenseActivationMode {
  START_NOW
  START_ON_DATE
  TARGET_EVENT_DATE
}

/// TM006 — has the athlete picked a start date yet? Distinct from
/// `TrainingLicenseStatus`: a license can be ACTIVE (purchase complete,
/// right to use granted) while still PENDING here (no date chosen, calendar
/// not instantiated) — that is the "não iniciado" state in `/app/planos`.
enum TrainingLicenseActivationStatus {
  PENDING
  ACTIVATED
}

/// T400 — Core product record.
/// Versions are tracked in TrainingProductVersion; the current live version is
/// referenced by currentVersionId to allow edits without breaking existing licenses.
model TrainingProduct {
  id              String                   @id @default(cuid())
  schoolId        String?
  coachId         String?
  title           String                   @db.VarChar(200)
  description     String?                  @db.Text
  sportType       String?                  @db.VarChar(100)
  durationWeeks   Int?
  status          TrainingProductStatus    @default(DRAFT)
  visibility      TrainingProductVisibility @default(PUBLIC)
  /// Price in minor currency units (e.g. centavos). null = free (RF-108); a
  /// CHECK in migration 0036 forbids 0, so "free" and "paid" are never
  /// ambiguous (TM003 / Q7).
  priceCents      Int?
  currency        String?                  @db.VarChar(3)
  currentVersionId String?                 @unique
  /// TM003 — commercial/catalog metadata (RF-105/RF-106). All nullable: a
  /// draft product may be missing most of these until the author fills the
  /// editor; publish-time validation (TM022) is where completeness is enforced.
  slug              String?                @db.VarChar(220)
  coverMediaId      String?
  objective         String?                @db.VarChar(300)
  difficulty        String?                @db.VarChar(50)
  goalType          String?                @db.VarChar(50)
  targetEventType   String?                @db.VarChar(50)
  targetDistance    String?                @db.VarChar(50)
  sessionsPerWeek   Int?
  sessionDurationMin Int?
  sessionDurationMax Int?
  weeklyMinutesMin  Int?
  weeklyMinutesMax  Int?
  sessionCount      Int?
  equipment         String?                @db.VarChar(500)
  language          String?                @db.VarChar(10)
  /// Free-form status text for the commercial offer (e.g. "on sale", "retiring") —
  /// distinct from `status`/`visibility`, which gate access, not marketing copy.
  availability      String?                @db.VarChar(100)
  sellerPolicyVersion String?              @db.VarChar(50)
  previewVersionId  String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  school          School?                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach           CoachProfile?            @relation(fields: [coachId], references: [id], onDelete: Restrict)
  currentVersion  TrainingProductVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions        TrainingProductVersion[] @relation("AllVersions")
  purchases       TrainingPurchase[]
  licenses        TrainingLicense[]
  media           MarketplaceMedia[]
  reviews         MarketplaceReview[]

  @@unique([slug])
  @@index([schoolId, status])
  @@index([coachId, status])
  @@index([status, visibility])
}

/// T401 — Immutable snapshot of a training plan at a point in time.
/// Workout templates are copied by reference here; the payload JSON preserves
/// the plan structure for stable license instantiation even after edits.
model TrainingProductVersion {
  id          String          @id @default(cuid())
  productId   String
  versionNumber Int
  /// TM004 — dispatch key for `planPayloadSchema` (TM010): 1 = one
  /// `workoutTemplateId` per day (legacy), 2 = `sessions[]` per day
  /// (multimodal/multi-session). See design D-03.
  schemaVersion Int           @default(1)
  /// Full plan as JSON. Shape depends on `schemaVersion` — see
  /// modules/school/domain/training-product-version.ts.
  planPayload Json
  /// TM004 — content hash of the published snapshot, for integrity checks
  /// and cheap "did this change" comparisons; not a security signature.
  contentHash String?         @db.VarChar(128)
  changeNote  String?         @db.VarChar(1000)
  /// TM004 — once set, this row is immutable (enforced by a DB trigger, not
  /// only application code — see design D-04 and migration 0037).
  publishedAt DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  product            TrainingProduct  @relation("AllVersions", fields: [productId], references: [id], onDelete: Cascade)
  currentForProduct  TrainingProduct? @relation("CurrentVersion")
  licenses           TrainingLicense[]
  purchases          TrainingPurchase[]
  reviews            MarketplaceReview[]

  @@unique([productId, versionNumber])
  @@index([productId, publishedAt(sort: Desc)])
}

/// T402 — Record of an athlete purchasing access to a training product.
model TrainingPurchase {
  id          String                @id @default(cuid())
  productId   String
  /// TM005 — the exact version being purchased, frozen at checkout time
  /// (RF-201: server revalidates and freezes price/version; the client
  /// never supplies these). Nullable only because pre-TM005 rows predate
  /// versioned checkout.
  versionId   String?
  athleteId   String
  /// Payment provider reference (Stripe charge ID, PIX txid, etc.). null for free products.
  paymentRef  String?               @db.VarChar(500)
  pricePaid   Int?
  currency    String?               @db.VarChar(3)
  status      TrainingPurchaseStatus @default(PENDING)
  /// TM005 — frozen offer terms at checkout time: { price, currency, sellerId, version, terms }.
  offerSnapshot Json?
  checkoutId    String?             @db.VarChar(200)
  provider      String?             @db.VarChar(50)
  providerEventId String?           @db.VarChar(200)
  /// TM005 — client-supplied idempotency key for the checkout call (RF-203).
  idempotencyKey String?            @db.VarChar(200)
  confirmedAt   DateTime?           @db.Timestamptz(3)
  refundReason  String?             @db.VarChar(500)
  purchasedAt DateTime              @default(now()) @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  product  TrainingProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  version  TrainingProductVersion? @relation(fields: [versionId], references: [id], onDelete: Restrict)
  athlete  User                    @relation("TrainingPurchaseAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  licenses TrainingLicense[]
  reviews  MarketplaceReview[]
  ledgerEntries SellerLedgerEntry[]

  @@unique([checkoutId])
  @@unique([provider, providerEventId])
  @@index([athleteId, purchasedAt(sort: Desc)])
  @@index([productId, status])
}

/// T403 — Activated license that allows one athlete to use one product version.
/// Created when a purchase completes (or for free products when requested).
/// Instantiating the calendar (T406) creates WorkoutAssignments from the version's planPayload.
model TrainingLicense {
  id               String               @id @default(cuid())
  productId        String
  versionId        String
  purchaseId       String?
  athleteId        String
  status           TrainingLicenseStatus @default(ACTIVE)
  /// Offset from the license start date (day 0). Null = starts immediately.
  startedAt        DateTime?            @db.Timestamptz(3)
  /// TM006 (Q1) — access is permanent by default: no forced expiry. Kept
  /// nullable/optional for a future time-boxed offer type, which is a
  /// product decision this migration does not make on its own.
  expiresAt        DateTime?            @db.Timestamptz(3)
  revokedAt        DateTime?            @db.Timestamptz(3)
  /// TM006 — how/when the athlete anchored the calendar (RF-109).
  activationMode    TrainingLicenseActivationMode?
  activationStatus  TrainingLicenseActivationStatus @default(PENDING)
  /// IANA timezone (e.g. "America/Sao_Paulo") used to compute local days —
  /// required before activation; fixes the UTC-only defect (RF-006).
  timezone          String?             @db.VarChar(64)
  chosenStartLocalDate   String?        @db.VarChar(10) // "YYYY-MM-DD", athlete's local date
  anchorEventLocalDate   String?        @db.VarChar(10) // "YYYY-MM-DD", for TARGET_EVENT_DATE mode
  /// True once the workout assignments have been created in the athlete's calendar.
  calendarInstantiated Boolean           @default(false)
  calendarInstantiatedAt DateTime?       @db.Timestamptz(3)
  completedAt         DateTime?          @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  product             TrainingProduct        @relation(fields: [productId], references: [id], onDelete: Restrict)
  version             TrainingProductVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  purchase            TrainingPurchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  athlete             User                   @relation("TrainingLicenseAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  workoutAssignments  WorkoutAssignment[]
  coachEngagements    LicenseCoachEngagement[]
  planAdaptations     PlanAdaptation[]

  @@index([athleteId, status])
  @@index([productId, status])
  @@index([purchaseId])
}

/// TM008 — Onda 3: a licensed athlete authorizing ANOTHER coach (not
/// necessarily the product's author) to follow and adapt their instance of
/// the plan. This is explicitly NOT `HistoryAccessGrant` (design D-05) and
/// NOT `CoachAthleteAssignment` — buying a plan never creates either.
enum LicenseCoachEngagementStatus {
  PENDING
  ACTIVE
  ENDED
}

model LicenseCoachEngagement {
  id          String                       @id @default(cuid())
  licenseId   String
  athleteId   String
  coachId     String
  schoolId    String?
  /// Flexible scope: e.g. { "sportTypes": ["swim"] } for a partial grant
  /// (RF-305) or { "full": true } for the whole plan. Interpreted by
  /// application code (TM072/TM085), not by the database.
  scope       Json
  status      LicenseCoachEngagementStatus @default(PENDING)
  requestedAt DateTime                     @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime?                    @db.Timestamptz(3)
  endedAt     DateTime?                    @db.Timestamptz(3)
  endReason   String?                      @db.VarChar(200)
  createdAt   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                     @updatedAt @db.Timestamptz(3)

  license TrainingLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  athlete User            @relation("LicenseCoachEngagementAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  coach   CoachProfile    @relation("LicenseCoachEngagementCoach", fields: [coachId], references: [id], onDelete: Restrict)
  school  School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([licenseId, status])
  @@index([coachId, status])
  @@index([athleteId, status])
}

enum PlanAdaptationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// TM008 — a coach-proposed change to ONE athlete's instance of a purchased
/// plan (design D-06). Never touches `TrainingProductVersion` (RF-004) or any
/// other buyer's license — only this `WorkoutAssignment`.
model PlanAdaptation {
  id                   String                @id @default(cuid())
  licenseId            String
  workoutAssignmentId  String
  coachId              String
  actorUserId          String
  beforeSnapshot       Json
  proposedSnapshot     Json
  reason               String                @db.VarChar(1000)
  status               PlanAdaptationStatus  @default(PENDING)
  /// RNF-003 — the WorkoutAssignment.adaptationVersion this proposal was
  /// based on; DecidePlanAdaptation (TM075) rejects with 409 if the
  /// assignment's current adaptationVersion has since moved.
  expectedVersion      Int
  acceptedByAthleteAt  DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  license           TrainingLicense   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  workoutAssignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)
  coach             CoachProfile      @relation("PlanAdaptationCoach", fields: [coachId], references: [id], onDelete: Restrict)
  actor             User              @relation("PlanAdaptationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([licenseId, status])
  @@index([workoutAssignmentId, status])
}

enum MarketplaceMediaKind {
  IMAGE
  VIDEO
}

/// PUBLIC = shown to anonymous visitors; PREVIEW = shown only as part of the
/// deliberately-public sample week/session (spec §5.2); PRIVATE = never
/// served outside an active license (e.g. attachments inside paid content).
enum MarketplaceMediaAccess {
  PUBLIC
  PREVIEW
  PRIVATE
}

enum MarketplaceMediaProcessingStatus {
  PENDING
  READY
  FAILED
}

/// TM009 — a product's cover/gallery/video. Publishing (TM022) requires at
/// least one PUBLIC, READY image before a product can leave DRAFT.
model MarketplaceMedia {
  id                String                            @id @default(cuid())
  productId         String
  kind              MarketplaceMediaKind
  storageKey        String                             @db.VarChar(500)
  thumbnailKey      String?                            @db.VarChar(500)
  altText           String                             @db.VarChar(300)
  caption           String?                            @db.VarChar(500)
  sortOrder         Int                                @default(0)
  access            MarketplaceMediaAccess              @default(PUBLIC)
  processingStatus  MarketplaceMediaProcessingStatus    @default(PENDING)
  createdAt         DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                           @updatedAt @db.Timestamptz(3)

  product TrainingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, access, sortOrder])
}

enum MarketplaceReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// TM009 — RF-112. Eligibility (confirmed purchase, active license, at least
/// one recorded session) is enforced by CreateMarketplaceReview (TM047), not
/// by the database; the database only guarantees "at most one CURRENT review
/// per purchase" via the unique index below.
model MarketplaceReview {
  id               String                             @id @default(cuid())
  productId        String
  purchaseId       String
  athleteId        String
  versionId        String
  stars            Int
  comment          String?                            @db.VarChar(2000)
  moderationStatus MarketplaceReviewModerationStatus  @default(PENDING)
  createdAt        DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                           @updatedAt @db.Timestamptz(3)

  product  TrainingProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase TrainingPurchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  athlete  User                   @relation("MarketplaceReviewAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  version  TrainingProductVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, athleteId, productId])
  @@index([productId, moderationStatus])
}

/// TM057 (RF-205) — polymorphic seller, same ownerType/ownerId convention
/// already used by WorkoutTemplate (WorkoutOwnerType) — a seller is whichever
/// of CoachProfile/School owns the TrainingProduct (XOR, migration 0036).
enum SellerType {
  COACH
  SCHOOL
}

enum SellerKycStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// TM057 — one row per (sellerType, sellerId, provider): where a seller's
/// payouts go. No fee/split percentage here or anywhere in this schema —
/// RF-205 requires that to be configuration, never a code/schema constant.
model SellerAccount {
  id               String          @id @default(cuid())
  sellerType       SellerType
  sellerId         String
  provider         String          @db.VarChar(50)
  /// Opaque reference to the provider's connected-account id (e.g. a Stripe
  /// Connect account id). Never a card/bank number — that lives only at the
  /// provider, never in this database.
  payoutAccountRef String?         @db.VarChar(200)
  kycStatus        SellerKycStatus @default(PENDING)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  ledgerEntries SellerLedgerEntry[]

  @@unique([sellerType, sellerId, provider])
}

enum SellerLedgerEntryType {
  SALE
  REFUND
  PAYOUT
}

/// TM057/TM067 — one immutable row per financial event. `feeAmount`/
/// `netAmount` are computed from configuration at write time (RF-205) and
/// stored as facts, not recomputed later — auditable even if the fee
/// configuration changes afterward. A refund does not mutate the original
/// SALE row; it appends a REFUND row (design pattern already used by
/// WorkoutAssignmentHistory — append, never rewrite).
model SellerLedgerEntry {
  id          String                @id @default(cuid())
  sellerAccountId String
  purchaseId  String
  grossAmount Int
  feeAmount   Int
  netAmount   Int
  currency    String                @db.VarChar(3)
  type        SellerLedgerEntryType
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)

  sellerAccount SellerAccount    @relation(fields: [sellerAccountId], references: [id], onDelete: Restrict)
  purchase      TrainingPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([sellerAccountId, createdAt])
  @@index([purchaseId])
}
