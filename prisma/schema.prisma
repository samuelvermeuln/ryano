generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolJoinPolicy {
  AUTO_APPROVE
  REQUIRE_APPROVAL
  INVITE_ONLY
}

enum CoachSelectionPolicy {
  ATHLETE_CHOOSES
  ADMIN_ASSIGNS
  AUTO_LOBBY
  INVITE_DEFINES_COACH
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  ENDED
}

enum CoachStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  ENDED
}

enum InvitationType {
  SCHOOL
  SCHOOL_COACH
  COACH
}

enum InvitationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  EXHAUSTED
}

enum InvitationUseResult {
  PENDING_APPROVAL
  JOINED
  REJECTED
  FAILED
}

enum HistoryGranteeType {
  SCHOOL
  COACH
}

enum HistoryGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum WorkoutOwnerType {
  COACH
  SCHOOL
  SYSTEM
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkoutStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WorkoutBlockType {
  WARMUP
  INTERVAL
  STEADY
  RECOVERY
  COOLDOWN
  DRILL
  FREE
  CUSTOM
}

// School-scoped roles are independent of the global authentication Role.
enum SchoolRole {
  OWNER
  ADMIN
  COACH
  ASSISTANT_COACH
  STAFF
  ATHLETE
  GUARDIAN
}

model School {
  id                   String                    @id @default(cuid())
  slug                 String                    @unique @db.VarChar(100)
  name                 String                    @db.VarChar(200)
  description          String?
  logoUrl              String?
  ownerUserId          String
  owner                User                      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  status               SchoolStatus              @default(ACTIVE)
  joinPolicy           SchoolJoinPolicy          @default(REQUIRE_APPROVAL)
  coachSelectionPolicy CoachSelectionPolicy      @default(ADMIN_ASSIGNS)
  // Dados cadastrais da escola
  email                String?                   @db.VarChar(254)
  phoneE164            String?                   @db.VarChar(20)
  cnpjEncrypted        String?
  cnpjHash             String?                   @unique @db.VarChar(64)
  // Endereço da escola
  postalCode           String?                   @db.VarChar(10)
  street               String?                   @db.VarChar(300)
  addressNumber        String?                   @db.VarChar(20)
  complement           String?                   @db.VarChar(100)
  district             String?                   @db.VarChar(100)
  city                 String?                   @db.VarChar(100)
  state                String?                   @db.VarChar(2)
  country              String?                   @db.VarChar(60)
  // Modalidades atendidas (array de RyvanoSportType)
  sportTypes           String[]
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
  deactivatedAt        DateTime?                 @db.Timestamptz(3)
  archivedAt           DateTime?                 @db.Timestamptz(3)
  memberships          SchoolMembership[]
  coachMemberships     CoachSchoolMembership[]
  athleteMemberships   SchoolAthleteMembership[]
  coachAssignments     CoachAthleteAssignment[]
  invitationLinks      InvitationLink[]
  historyAccessGrants  HistoryAccessGrant[]
  workoutTemplates     WorkoutTemplate[]
  originWorkouts       Workout[]                 @relation("WorkoutOriginSchool")
  assignments          WorkoutAssignment[]
  teams                Team[]
  trainingProducts     TrainingProduct[]

  @@index([ownerUserId, status])
  @@index([status, name, id])
}

enum Role {
  USER
  ADMIN
}

enum AvatarSource {
  CUSTOM
  GOOGLE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum WearableProvider {
  GARMIN
  STRAVA
  APPLE
  POLAR
  COROS
  SUUNTO
  FITBIT
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  SYNCING
  ERROR
  RECONNECT_REQUIRED
}

enum SecretType {
  GARMIN_EMAIL
  GARMIN_PASSWORD
  GARMIN_API_KEY
  STRAVA_ACCESS_TOKEN
  STRAVA_REFRESH_TOKEN
}

enum Channel {
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model User {
  id                       String                     @id @default(cuid())
  name                     String?
  email                    String                     @unique
  emailVerified            DateTime?
  image                    String?
  avatarSource             AvatarSource?
  role                     Role                       @default(USER)
  status                   UserStatus                 @default(PENDING)
  passwordHash             String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  profile                  UserProfile?
  address                  Address?
  wearableConnections      WearableConnection[]
  activities               Activity[]
  whatsappIdentity         WhatsAppIdentity?
  notificationPreference   NotificationPreference?
  activationTokens         WhatsAppActivationToken[]
  messageDeliveries        MessageDelivery[]
  integrationEvents        IntegrationEvent[]
  auditLogs                AdminAuditLog[]            @relation("AdminAuditActor")
  passwordResetTokens      PasswordResetToken[]
  ownedSchools             School[]
  schoolMemberships        SchoolMembership[]
  athleteMemberships       SchoolAthleteMembership[]
  coachProfile             CoachProfile?
  coachAssignments         CoachAthleteAssignment[]
  createdInvitationLinks   InvitationLink[]
  invitationUses           InvitationUse[]            @relation("InvitationUseActor")
  athleteInvitationUses    InvitationUse[]            @relation("InvitationUseAthlete")
  grantedHistoryAccesses   HistoryAccessGrant[]       @relation("HistoryGrantGrantedBy")
  revokedHistoryAccesses   HistoryAccessGrant[]       @relation("HistoryGrantRevokedBy")
  historyAccessGrants      HistoryAccessGrant[]
  assignedWorkouts         WorkoutAssignment[]        @relation("WorkoutAssignmentAthlete")
  assignedWorkoutsBy       WorkoutAssignment[]        @relation("WorkoutAssignmentAssigner")
  workoutAssignmentHistory WorkoutAssignmentHistory[] @relation("WorkoutAssignmentHistoryActor")

  teamAthletes      TeamAthlete[]      @relation("UserTeamAthlete")
  workoutExecutions WorkoutExecution[] @relation("WorkoutExecutionAthlete")
  trainingPurchases TrainingPurchase[] @relation("TrainingPurchaseAthlete")
  trainingLicenses  TrainingLicense[]  @relation("TrainingLicenseAthlete")
}

model CoachProfile {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  displayName         String                   @db.VarChar
  bio                 String?                  @db.Text
  status              CoachStatus              @default(ACTIVE)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  schoolMemberships   CoachSchoolMembership[]
  athleteAssignments  CoachAthleteAssignment[]
  invitationLinks     InvitationLink[]
  historyAccessGrants HistoryAccessGrant[]
  workoutTemplates    WorkoutTemplate[]
  authoredWorkouts    Workout[]                @relation("WorkoutAuthorCoach")
  assignments         WorkoutAssignment[]
  teamCoaches         TeamCoach[]
  coachEvaluations    CoachEvaluation[]
  trainingProducts    TrainingProduct[]
}

/// Reusable library entry. Owner identity is polymorphic to retain SYSTEM support.
model WorkoutTemplate {
  id            String           @id @default(cuid())
  ownerType     WorkoutOwnerType
  ownerId       String
  authorCoachId String?
  schoolId      String?
  title         String           @db.VarChar(200)
  description   String?          @db.Text
  sportType     String           @db.VarChar(100)
  version       Int
  status        TemplateStatus   @default(DRAFT)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  authorCoach         CoachProfile?      @relation(fields: [authorCoachId], references: [id], onDelete: Restrict)
  school              School?            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  workouts            Workout[]
  workoutAssignments  WorkoutAssignment[]

  @@index([ownerType, ownerId, status, updatedAt, id])
  @@index([authorCoachId, status])
  @@index([schoolId, status])
}

/// A concrete prescription holds a self-contained snapshot, never a live template view.
model Workout {
  id               String              @id @default(cuid())
  templateId       String?
  templateVersion  Int?
  authorCoachId    String?
  originSchoolId   String?
  title            String              @db.VarChar(200)
  description      String?             @db.Text
  sportType        String              @db.VarChar(100)
  scheduledDate    DateTime?           @db.Date
  scheduledStartAt DateTime?           @db.Timestamptz(3)
  status           WorkoutStatus       @default(DRAFT)
  snapshotPayload  Json
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  template         WorkoutTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  authorCoach      CoachProfile?       @relation("WorkoutAuthorCoach", fields: [authorCoachId], references: [id], onDelete: Restrict)
  originSchool     School?             @relation("WorkoutOriginSchool", fields: [originSchoolId], references: [id], onDelete: Restrict)
  blocks           WorkoutBlock[]
  assignments      WorkoutAssignment[]

  @@index([templateId, templateVersion])
  @@index([authorCoachId, status, createdAt, id])
  @@index([originSchoolId, status, scheduledDate, id])
}

/// Normalized blocks are an optional query aid; the immutable snapshot is authoritative.
model WorkoutBlock {
  id            String           @id @default(cuid())
  workoutId     String
  position      Int
  blockType     WorkoutBlockType
  title         String?          @db.VarChar(200)
  distanceM     Decimal?         @db.Decimal(12, 2)
  durationS     Int?
  repetitions   Int?
  targetPayload Json?
  restPayload   Json?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  workout       Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, position])
  @@index([workoutId, position])
}

/// Scope, usage limits and terminal-status checks are enforced in migration 0017.
/// Only the token hash is persisted; never store or log the public bearer token.
model InvitationLink {
  id               String           @id @default(cuid())
  tokenHash        String           @unique @db.VarChar
  type             InvitationType
  schoolId         String?
  coachId          String?
  createdBy        String
  requiresApproval Boolean
  expiresAt        DateTime?        @db.Timestamptz(3)
  maxUses          Int?
  usedCount        Int              @default(0)
  status           InvitationStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  revokedAt        DateTime?        @db.Timestamptz(3)
  school           School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach            CoachProfile?    @relation(fields: [coachId], references: [id], onDelete: Restrict)
  creator          User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  uses             InvitationUse[]

  @@index([schoolId, status])
  @@index([coachId, status])
  @@index([createdBy])
  @@index([status, expiresAt])
}

/// Audit events may repeat for the same actor and invitation; acceptance owns retry idempotency.
model InvitationUse {
  id           String              @id @default(cuid())
  invitationId String
  userId       String
  athleteId    String?
  usedAt       DateTime            @default(now()) @db.Timestamptz(3)
  result       InvitationUseResult
  invitation   InvitationLink      @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  user         User                @relation("InvitationUseActor", fields: [userId], references: [id], onDelete: Restrict)
  athlete      User?               @relation("InvitationUseAthlete", fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([invitationId, usedAt, id])
  @@index([userId, usedAt, id])
  @@index([athleteId, usedAt, id])
  // T316: replay check in AcceptInvitation: WHERE invitationId = ? AND userId = ?
  @@index([invitationId, userId])
}

/// Athlete-owned access grants preserve source data while allowing revocable reads.
model HistoryAccessGrant {
  id          String             @id @default(cuid())
  athleteId   String
  granteeType HistoryGranteeType
  granteeId   String
  schoolId    String?
  coachId     String?
  scope       Json
  fromDate    DateTime?          @db.Date
  toDate      DateTime?          @db.Date
  status      HistoryGrantStatus @default(ACTIVE)
  grantedBy   String
  grantedAt   DateTime           @default(now()) @db.Timestamptz(3)
  revokedBy   String?
  revokedAt   DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  athlete     User               @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  school      School?            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach       CoachProfile?      @relation(fields: [coachId], references: [id], onDelete: Restrict)
  grantor     User               @relation("HistoryGrantGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  revoker     User?              @relation("HistoryGrantRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)

  @@index([athleteId, status, grantedAt, id])
  @@index([granteeType, granteeId, status])
  @@index([schoolId, status])
  @@index([coachId, status])
}

/// Primary ACTIVE uniqueness per school and PENDING startedAt NULL are enforced in migration 0016.
model CoachAthleteAssignment {
  id         String           @id @default(cuid())
  athleteId  String
  coachId    String
  schoolId   String?
  status     AssignmentStatus @default(PENDING)
  isPrimary  Boolean          @default(true)
  sportType  String?          @db.VarChar
  startedAt  DateTime?        @db.Timestamptz(3)
  endedAt    DateTime?        @db.Timestamptz(3)
  assignedBy String?
  endedBy    String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  athlete    User             @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  coach      CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  school     School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, athleteId, status])
  @@index([coachId, status])
}

/// Active pair uniqueness and PENDING startedAt NULL are enforced in migration 0014.
model CoachSchoolMembership {
  id          String           @id @default(cuid())
  coachId     String
  schoolId    String
  status      MembershipStatus @default(PENDING)
  requestedAt DateTime         @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?        @db.Timestamptz(3)
  startedAt   DateTime?        @db.Timestamptz(3)
  endedAt     DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  coach       CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([coachId, status])
}

enum MembershipJoinSource {
  SCHOOL_INVITE
  SCHOOL_COACH_INVITE
  COACH_INVITE
  MANUAL_SEARCH
  ADMIN_CREATED
  MIGRATION
}

/// Active pair uniqueness and PENDING startedAt NULL are enforced in migration 0015.
model SchoolAthleteMembership {
  id         String               @id @default(cuid())
  schoolId   String
  athleteId  String
  status     MembershipStatus     @default(PENDING)
  joinSource MembershipJoinSource
  approvedBy String?
  approvedAt DateTime?            @db.Timestamptz(3)
  rejectedBy String?
  rejectedAt DateTime?            @db.Timestamptz(3)
  revokedBy  String?
  revokedAt  DateTime?            @db.Timestamptz(3)
  startedAt  DateTime?            @db.Timestamptz(3)
  endedAt    DateTime?            @db.Timestamptz(3)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)
  school     School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  athlete    User                 @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([athleteId, status])
}

/// PENDING requires startedAt NULL, enforced by the CHECK in migration 0011.
model SchoolMembership {
  id        String                 @id @default(cuid())
  schoolId  String
  userId    String
  status    MembershipStatus       @default(PENDING)
  startedAt DateTime?              @db.Timestamptz(3)
  endedAt   DateTime?              @db.Timestamptz(3)
  createdAt DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt DateTime               @updatedAt @db.Timestamptz(3)
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles     SchoolMembershipRole[]

  @@index([schoolId, status])
  @@index([userId, status])
}

model SchoolMembershipRole {
  id           String           @id @default(cuid())
  membershipId String
  role         SchoolRole
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  membership   SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([membershipId, role])
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  cpfEncrypted            String?
  cpfHash                 String?   @unique
  phoneE164               String?
  heightCm                Int?
  weightKg                Decimal?  @db.Decimal(5, 2)
  onboardingCompletedAt   DateTime?
  activityLayoutOrder     Json?
  dashboardLayoutOrder    Json?
  integrationsLayoutOrder Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(cuid())
  userId     String   @unique
  postalCode String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WearableConnection {
  id                         String                   @id @default(cuid())
  userId                     String
  provider                   WearableProvider
  externalAccountId          String?
  status                     ConnectionStatus         @default(DISCONNECTED)
  capabilities               String[]
  label                      String?
  lastSyncAt                 DateTime?
  lastSyncStatus             String?
  lastErrorCode              String?
  lastProbeAt                DateTime?
  nextProbeAt                DateTime?
  lastSeenActivityExternalId String?
  lastProbeStatus            String?
  lastProbeErrorCode         String?
  lastProbeFailureCount      Int                      @default(0)
  lastEventAt                DateTime?
  lastSuccessAt              DateTime?
  lastErrorAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secrets                    WearableSecret[]
  activities                 Activity[]
  stravaDetails              StravaConnectionDetails?

  @@unique([userId, provider])
  @@index([provider, nextProbeAt])
}

model WearableSecret {
  id                   String             @id @default(cuid())
  wearableConnectionId String
  secretType           SecretType
  ciphertext           String
  nonce                String
  authTag              String
  keyVersion           Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)

  @@unique([wearableConnectionId, secretType])
}

model Activity {
  id                   String             @id @default(cuid())
  userId               String
  wearableConnectionId String
  externalId           String
  provider             WearableProvider
  sportType            String
  providerSportType    String?
  name                 String?
  startedAt            DateTime
  endedAt              DateTime?
  durationSeconds      Int?
  movingSeconds        Int?
  distanceMeters       Float?
  calories             Int?
  averageHeartRate     Int?
  maxHeartRate         Int?
  averagePace          Float?
  averageSpeed         Float?
  maxSpeed             Float?
  elevationGain        Float?
  averageCadence       Float?
  averagePower         Float?
  maxPower             Float?
  timezone             String?
  metrics              Json?
  rawPayload           Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, userId])
  @@index([userId, startedAt])
}

model WhatsAppIdentity {
  id          String    @id @default(cuid())
  userId      String    @unique
  phoneE164   String
  externalJid String?
  verifiedAt  DateTime?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsAppActivationToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  phoneE164    String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  postActivityReport Boolean  @default(true)
  dailySummary       Boolean  @default(false)
  weeklySummary      Boolean  @default(false)
  reportTime         String?
  timezone           String?  @default("America/Sao_Paulo")
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageDelivery {
  id                String         @id @default(cuid())
  userId            String
  channel           Channel
  type              String
  provider          String
  externalMessageId String?
  status            DeliveryStatus @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorCode         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model IntegrationEvent {
  id          String    @id @default(cuid())
  userId      String?
  provider    String
  eventType   String
  externalId  String?
  payload     Json?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, eventType, externalId])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  scope     String
  key       String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([resetAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String
  targetUserId String?
  entityType   String?
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  // T316: audit queries are scoped to actor or entity
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Strava-specific models
// Provider-specific persistence for the modular Strava integration. Canonical
// activities live in the shared `Activity` model; the models below hold data
// that only makes sense for Strava (OAuth connection details, webhook lifecycle
// and short-lived caches).
// Note: StravaStreamCache is intentionally deferred — it will only be added if
// activity streams turn out to be necessary (see design section 3).
// ---------------------------------------------------------------------------

model StravaConnectionDetails {
  id                   String             @id @default(cuid())
  wearableConnectionId String             @unique
  athleteId            String             @unique
  scopes               String[]
  accessTokenExpiresAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)
}

model StravaWebhookSubscription {
  id                     String   @id @default(cuid())
  externalSubscriptionId String   @unique
  callbackUrl            String
  status                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model StravaWebhookEvent {
  id               String    @id @default(cuid())
  ownerAthleteId   String?
  objectType       String
  objectId         String
  aspectType       String
  eventTime        DateTime
  payload          Json?
  processingStatus String // PENDING | PROCESSED | FAILED
  attemptCount     Int       @default(0)
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  expiresAt        DateTime

  @@index([processingStatus, receivedAt])
  @@index([ownerAthleteId, receivedAt])
}

model StravaActivityCache {
  id                   String    @id @default(cuid())
  wearableConnectionId String
  stravaActivityId     String
  sportType            String?
  startedAt            DateTime?
  payload              Json
  fetchedAt            DateTime
  expiresAt            DateTime

  @@unique([wearableConnectionId, stravaActivityId])
  @@index([expiresAt])
}

model Team {
  id                 String              @id @default(cuid())
  schoolId           String
  name               String              @db.VarChar(200)
  archivedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  members            TeamAthlete[]
  coaches            TeamCoach[]
  workoutAssignments WorkoutAssignment[]

  @@index([schoolId, archivedAt])
}

model TeamAthlete {
  id        String   @id @default(cuid())
  teamId    String
  athleteId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete   User     @relation("UserTeamAthlete", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([teamId, athleteId])
}

/// Explicit assignment of a coach to a team, allowing coaches to manage
/// specific teams rather than every team in their school.
model TeamCoach {
  id        String   @id @default(cuid())
  teamId    String
  coachId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([teamId, coachId])
  @@index([coachId])
}

model WorkoutAssignment {
  id          String                  @id @default(cuid())
  /// Null for template-based assignments (T406) where the Workout record is not yet resolved.
  workoutId   String?
  /// Null for template-based assignments instantiated by the license system (T406).
  workoutTemplateId String?
  athleteId   String
  /// Null for system-initiated assignments (e.g. license calendar instantiation).
  assignedBy  String?
  schoolId    String?
  coachId     String?
  teamId      String?
  scheduledAt DateTime?               @db.Timestamptz(3)
  dueAt       DateTime?               @db.Timestamptz(3)
  status      WorkoutAssignmentStatus @default(SCHEDULED)
  /// Match tracking (T210–T215)
  matchStatus      WorkoutMatchStatus?
  matchedActivityId String?
  matchedAt        DateTime?           @db.Timestamptz(3)
  matchScore       Float?
  /// Link back to the license that created this assignment (T406).
  trainingLicenseId String?
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)

  workout         Workout?                   @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  workoutTemplate WorkoutTemplate?           @relation(fields: [workoutTemplateId], references: [id], onDelete: Restrict)
  athlete         User                       @relation("WorkoutAssignmentAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  assigner        User?                      @relation("WorkoutAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)
  school          School?                    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach           CoachProfile?              @relation(fields: [coachId], references: [id], onDelete: Restrict)
  team            Team?                      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  trainingLicense TrainingLicense?           @relation(fields: [trainingLicenseId], references: [id], onDelete: SetNull)
  history         WorkoutAssignmentHistory[]
  executions      WorkoutExecution[]
  compliances     WorkoutCompliance[]
  evaluations     CoachEvaluation[]
  feedbacks       AthleteFeedback[]

  @@index([athleteId, status, id])
  @@index([teamId, status])
  @@index([schoolId, status])
  @@index([coachId, status])
  @@index([trainingLicenseId])
  // T316: combined filter used in GET /api/workout-assignments (schoolId + athleteId + status + cursor)
  @@index([schoolId, athleteId, status, id])
}

model WorkoutAssignmentHistory {
  id                  String   @id @default(cuid())
  workoutAssignmentId String
  eventType           String   @db.VarChar(100)
  actorUserId         String
  payload             Json
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  workoutAssignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)
  actor             User              @relation("WorkoutAssignmentHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([workoutAssignmentId, createdAt])
}

enum WorkoutAssignmentStatus {
  SCHEDULED
  AVAILABLE
  COMPLETED
  PARTIALLY_COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
  JUSTIFIED
  UNPLANNED
}

/// Records the execution of a prescribed workout, matched to a provider activity.
/// matchStatus drives the reconciliation lifecycle:
///   PENDING      — activity ingested; automatic matching in progress
///   AUTO_MATCHED — system found a confident match (score ≥ threshold)
///   CONFIRMED    — athlete or coach confirmed the auto-match
///   OVERRIDDEN   — user chose a different activity than the auto-match
///   NO_MATCH     — matching ran and found no suitable candidate
model WorkoutExecution {
  id                   String               @id @default(cuid())
  workoutAssignmentId  String
  athleteId            String
  /// Provider that supplied the activity (e.g. "strava", "garmin").
  source               String               @db.VarChar(50)
  /// Activity identifier in the provider's system.
  externalId           String               @db.VarChar(256)
  sportType            String               @db.VarChar(100)
  startedAt            DateTime             @db.Timestamptz(3)
  durationSeconds      Int?
  movingSeconds        Int?
  distanceMeters       Float?
  averageHeartRate     Int?
  maxHeartRate         Int?
  averageSpeed         Float?
  elevationGain        Float?
  averagePower         Int?
  /// Composite 0–100 match score computed by WorkoutMatchingService.
  matchScore           Int
  matchStatus          WorkoutMatchStatus   @default(PENDING)
  /// Snapshot of the raw provider activity payload for audit and re-scoring.
  activityPayload      Json
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  assignment   WorkoutAssignment  @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)
  athlete      User               @relation("WorkoutExecutionAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  compliance   WorkoutCompliance?
  evaluations  CoachEvaluation[]
  feedback     AthleteFeedback?

  @@unique([workoutAssignmentId, source, externalId])
  @@index([athleteId, startedAt])
  @@index([workoutAssignmentId, matchStatus])
  // T316: ordered listing in GET /api/workout-assignments/[id]/executions
  @@index([workoutAssignmentId, createdAt(sort: Desc)])
}

enum WorkoutMatchStatus {
  PENDING
  AUTO_MATCHED
  CONFIRMED
  OVERRIDDEN
  NO_MATCH
}

// ---------------------------------------------------------------------------
// T220 — CoachEvaluation
// ---------------------------------------------------------------------------

model CoachEvaluation {
  id                   String   @id @default(cuid())
  workoutExecutionId   String
  workoutAssignmentId  String
  athleteId            String
  coachId              String
  schoolId             String
  /// 0–100 integer (displayed as 0.0–10.0 by dividing by 10).
  overallScore         Int
  note                 String?  @db.VarChar(5000)
  isVisible            Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  execution  WorkoutExecution  @relation(fields: [workoutExecutionId], references: [id], onDelete: Cascade)
  assignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)
  coach      CoachProfile      @relation(fields: [coachId], references: [id], onDelete: Restrict)

  @@unique([workoutExecutionId, coachId])
  @@index([workoutAssignmentId])
  @@index([athleteId])
  // T316: athlete-scoped evaluation listing filters on (executionId, isVisible)
  @@index([workoutExecutionId, isVisible])
}

// ---------------------------------------------------------------------------
// T221 — AthleteFeedback
// ---------------------------------------------------------------------------

model AthleteFeedback {
  id                   String   @id @default(cuid())
  workoutExecutionId   String   @unique
  workoutAssignmentId  String
  athleteId            String
  /// Rated Perceived Exertion 1–10.
  rpe                  Int
  /// Subjective mood 1–5 (optional).
  mood                 Int?
  /// Subjective energy level 1–5 (optional).
  energy               Int?
  comment              String?  @db.VarChar(2000)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  execution  WorkoutExecution  @relation(fields: [workoutExecutionId], references: [id], onDelete: Cascade)
  assignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)

  @@index([workoutAssignmentId])
  @@index([athleteId])
}

// ---------------------------------------------------------------------------
// T240 — SchoolAuditLog
// ---------------------------------------------------------------------------

/// Append-only audit trail for school-module operations. Never update or delete rows.
model SchoolAuditLog {
  id           String   @id @default(cuid())
  schoolId     String
  actorUserId  String?
  action       String   @db.VarChar(100)
  entityType   String   @db.VarChar(100)
  entityId     String
  metadata     Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, schoolId])
}

// ---------------------------------------------------------------------------
// T190 — WorkoutCompliance
// ---------------------------------------------------------------------------

model WorkoutCompliance {
  id                   String   @id @default(cuid())
  workoutExecutionId   String   @unique
  workoutAssignmentId  String
  athleteId            String
  /// Weighted compliance score 0–100.
  overallScore         Int
  /// Per-dimension scores as JSON: { distance?, duration?, pace?, heartRate?, power?, intervals?, rest?, zones? }
  breakdown            Json
  /// Which ComplianceStrategy was used (e.g. "run", "swim", "default").
  strategyKey          String   @db.VarChar(50)
  /// Monotonic version of the compliance algorithm (T206).
  algorithmVersion     Int
  calculatedAt         DateTime @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  execution  WorkoutExecution  @relation(fields: [workoutExecutionId], references: [id], onDelete: Cascade)
  assignment WorkoutAssignment @relation(fields: [workoutAssignmentId], references: [id], onDelete: Cascade)

  @@index([workoutAssignmentId])
  @@index([athleteId])
  // T316: compliance timeline listing ordered by most recent
  @@index([athleteId, calculatedAt(sort: Desc)])
}

// =============================================================================
// FASE 18 — TrainingProduct marketplace (T400–T403)
// =============================================================================

/// Lifecycle of a training plan product published by a coach or school.
enum TrainingProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Who may purchase/access the product.
enum TrainingProductVisibility {
  PUBLIC
  UNLISTED
  SCHOOL_ONLY
}

/// Terminal states for a purchase.
enum TrainingPurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

/// Activation state for a license instance assigned to one athlete.
enum TrainingLicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// T400 — Core product record.
/// Versions are tracked in TrainingProductVersion; the current live version is
/// referenced by currentVersionId to allow edits without breaking existing licenses.
model TrainingProduct {
  id              String                   @id @default(cuid())
  schoolId        String?
  coachId         String?
  title           String                   @db.VarChar(200)
  description     String?                  @db.Text
  sportType       String?                  @db.VarChar(100)
  durationWeeks   Int?
  status          TrainingProductStatus    @default(DRAFT)
  visibility      TrainingProductVisibility @default(PUBLIC)
  /// Price in minor currency units (e.g. centavos). null = free.
  priceCents      Int?
  currency        String?                  @db.VarChar(3)
  currentVersionId String?                 @unique
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  school          School?                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach           CoachProfile?            @relation(fields: [coachId], references: [id], onDelete: Restrict)
  currentVersion  TrainingProductVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions        TrainingProductVersion[] @relation("AllVersions")
  purchases       TrainingPurchase[]
  licenses        TrainingLicense[]

  @@index([schoolId, status])
  @@index([coachId, status])
  @@index([status, visibility])
}

/// T401 — Immutable snapshot of a training plan at a point in time.
/// Workout templates are copied by reference here; the payload JSON preserves
/// the plan structure for stable license instantiation even after edits.
model TrainingProductVersion {
  id          String          @id @default(cuid())
  productId   String
  versionNumber Int
  /// Full plan as JSON: { weeks: [{ week: number, days: [{ workoutTemplateId, dayOfWeek }] }] }
  planPayload Json
  changeNote  String?         @db.VarChar(1000)
  publishedAt DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  product            TrainingProduct  @relation("AllVersions", fields: [productId], references: [id], onDelete: Cascade)
  currentForProduct  TrainingProduct? @relation("CurrentVersion")
  licenses           TrainingLicense[]

  @@unique([productId, versionNumber])
  @@index([productId, publishedAt(sort: Desc)])
}

/// T402 — Record of an athlete purchasing access to a training product.
model TrainingPurchase {
  id          String                @id @default(cuid())
  productId   String
  athleteId   String
  /// Payment provider reference (Stripe charge ID, PIX txid, etc.). null for free products.
  paymentRef  String?               @db.VarChar(500)
  pricePaid   Int?
  currency    String?               @db.VarChar(3)
  status      TrainingPurchaseStatus @default(PENDING)
  purchasedAt DateTime              @default(now()) @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  product  TrainingProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  athlete  User              @relation("TrainingPurchaseAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  licenses TrainingLicense[]

  @@index([athleteId, purchasedAt(sort: Desc)])
  @@index([productId, status])
}

/// T403 — Activated license that allows one athlete to use one product version.
/// Created when a purchase completes (or for free products when requested).
/// Instantiating the calendar (T406) creates WorkoutAssignments from the version's planPayload.
model TrainingLicense {
  id               String               @id @default(cuid())
  productId        String
  versionId        String
  purchaseId       String?
  athleteId        String
  status           TrainingLicenseStatus @default(ACTIVE)
  /// Offset from the license start date (day 0). Null = starts immediately.
  startedAt        DateTime?            @db.Timestamptz(3)
  expiresAt        DateTime?            @db.Timestamptz(3)
  revokedAt        DateTime?            @db.Timestamptz(3)
  /// True once the workout assignments have been created in the athlete's calendar.
  calendarInstantiated Boolean           @default(false)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  product             TrainingProduct        @relation(fields: [productId], references: [id], onDelete: Restrict)
  version             TrainingProductVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  purchase            TrainingPurchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  athlete             User                   @relation("TrainingLicenseAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  workoutAssignments  WorkoutAssignment[]

  @@index([athleteId, status])
  @@index([productId, status])
  @@index([purchaseId])
}
