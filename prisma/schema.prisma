generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum SchoolJoinPolicy {
  AUTO_APPROVE
  REQUIRE_APPROVAL
  INVITE_ONLY
}

enum CoachSelectionPolicy {
  ATHLETE_CHOOSES
  ADMIN_ASSIGNS
  AUTO_LOBBY
  INVITE_DEFINES_COACH
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  ENDED
}

enum CoachStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
  ENDED
}

enum InvitationType {
  SCHOOL
  SCHOOL_COACH
  COACH
}

enum InvitationStatus {
  ACTIVE
  EXPIRED
  REVOKED
  EXHAUSTED
}

enum InvitationUseResult {
  PENDING_APPROVAL
  JOINED
  REJECTED
  FAILED
}

enum HistoryGranteeType {
  SCHOOL
  COACH
}

enum HistoryGrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// School-scoped roles are independent of the global authentication Role.
enum SchoolRole {
  OWNER
  ADMIN
  COACH
  ASSISTANT_COACH
  STAFF
  ATHLETE
  GUARDIAN
}

model School {
  id                   String               @id @default(cuid())
  slug                 String               @unique @db.VarChar(100)
  name                 String               @db.VarChar(200)
  description          String?
  logoUrl              String?
  ownerUserId          String
  owner                User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  status               SchoolStatus         @default(ACTIVE)
  joinPolicy           SchoolJoinPolicy     @default(REQUIRE_APPROVAL)
  coachSelectionPolicy CoachSelectionPolicy @default(ADMIN_ASSIGNS)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  deactivatedAt        DateTime?            @db.Timestamptz(3)
  archivedAt           DateTime?            @db.Timestamptz(3)
  memberships          SchoolMembership[]
  coachMemberships     CoachSchoolMembership[]
  athleteMemberships   SchoolAthleteMembership[]
  coachAssignments     CoachAthleteAssignment[]
  invitationLinks      InvitationLink[]

  @@index([ownerUserId, status])
  @@index([status, name, id])
}

enum Role {
  USER
  ADMIN
}

enum AvatarSource {
  CUSTOM
  GOOGLE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum WearableProvider {
  GARMIN
  STRAVA
  APPLE
  POLAR
  COROS
  SUUNTO
  FITBIT
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  SYNCING
  ERROR
  RECONNECT_REQUIRED
}

enum SecretType {
  GARMIN_EMAIL
  GARMIN_PASSWORD
  GARMIN_API_KEY
  STRAVA_ACCESS_TOKEN
  STRAVA_REFRESH_TOKEN
}

enum Channel {
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model User {
  id                     String                    @id @default(cuid())
  name                   String?
  email                  String                    @unique
  emailVerified          DateTime?
  image                  String?
  avatarSource           AvatarSource?
  role                   Role                      @default(USER)
  status                 UserStatus                @default(PENDING)
  passwordHash           String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  accounts               Account[]
  sessions               Session[]
  profile                UserProfile?
  address                Address?
  wearableConnections    WearableConnection[]
  activities             Activity[]
  whatsappIdentity       WhatsAppIdentity?
  notificationPreference NotificationPreference?
  activationTokens       WhatsAppActivationToken[]
  messageDeliveries      MessageDelivery[]
  integrationEvents      IntegrationEvent[]
  auditLogs              AdminAuditLog[]           @relation("AdminAuditActor")
  passwordResetTokens    PasswordResetToken[]
  ownedSchools           School[]
  schoolMemberships      SchoolMembership[]
  athleteMemberships     SchoolAthleteMembership[]
  coachProfile           CoachProfile?
  coachAssignments       CoachAthleteAssignment[]
  createdInvitationLinks InvitationLink[]
  invitationUses         InvitationUse[] @relation("InvitationUseActor")
  athleteInvitationUses  InvitationUse[] @relation("InvitationUseAthlete")
}

model CoachProfile {
  id          String      @id @default(cuid())
  userId      String      @unique
  displayName String      @db.VarChar
  bio         String?     @db.Text
  status      CoachStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  schoolMemberships CoachSchoolMembership[]
  athleteAssignments CoachAthleteAssignment[]
  invitationLinks InvitationLink[]
}

/// Scope, usage limits and terminal-status checks are enforced in migration 0017.
/// Only the token hash is persisted; never store or log the public bearer token.
model InvitationLink {
  id               String           @id @default(cuid())
  tokenHash        String           @unique @db.VarChar
  type             InvitationType
  schoolId         String?
  coachId          String?
  createdBy        String
  requiresApproval Boolean
  expiresAt        DateTime?        @db.Timestamptz(3)
  maxUses          Int?
  usedCount        Int              @default(0)
  status           InvitationStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  revokedAt        DateTime?        @db.Timestamptz(3)
  school           School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  coach            CoachProfile?    @relation(fields: [coachId], references: [id], onDelete: Restrict)
  creator          User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  uses             InvitationUse[]

  @@index([schoolId, status])
  @@index([coachId, status])
  @@index([createdBy])
  @@index([status, expiresAt])
}

/// Audit events may repeat for the same actor and invitation; acceptance owns retry idempotency.
model InvitationUse {
  id           String              @id @default(cuid())
  invitationId String
  userId       String
  athleteId    String?
  usedAt       DateTime            @default(now()) @db.Timestamptz(3)
  result       InvitationUseResult
  invitation   InvitationLink      @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  user         User                @relation("InvitationUseActor", fields: [userId], references: [id], onDelete: Restrict)
  athlete      User?               @relation("InvitationUseAthlete", fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([invitationId, usedAt, id])
  @@index([userId, usedAt, id])
  @@index([athleteId, usedAt, id])
}

/// Primary ACTIVE uniqueness per school and PENDING startedAt NULL are enforced in migration 0016.
model CoachAthleteAssignment {
  id         String           @id @default(cuid())
  athleteId  String
  coachId    String
  schoolId   String?
  status     AssignmentStatus @default(PENDING)
  isPrimary  Boolean          @default(true)
  sportType  String?          @db.VarChar
  startedAt  DateTime?        @db.Timestamptz(3)
  endedAt    DateTime?        @db.Timestamptz(3)
  assignedBy String?
  endedBy    String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  athlete    User             @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  coach      CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  school     School?          @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, athleteId, status])
  @@index([coachId, status])
}

/// Active pair uniqueness and PENDING startedAt NULL are enforced in migration 0014.
model CoachSchoolMembership {
  id          String           @id @default(cuid())
  coachId     String
  schoolId    String
  status      MembershipStatus @default(PENDING)
  requestedAt DateTime         @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?        @db.Timestamptz(3)
  startedAt   DateTime?        @db.Timestamptz(3)
  endedAt     DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  coach       CoachProfile     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([coachId, status])
}

enum MembershipJoinSource {
  SCHOOL_INVITE
  SCHOOL_COACH_INVITE
  COACH_INVITE
  MANUAL_SEARCH
  ADMIN_CREATED
  MIGRATION
}

/// Active pair uniqueness and PENDING startedAt NULL are enforced in migration 0015.
model SchoolAthleteMembership {
  id          String               @id @default(cuid())
  schoolId    String
  athleteId   String
  status      MembershipStatus     @default(PENDING)
  joinSource  MembershipJoinSource
  approvedBy  String?
  approvedAt  DateTime?            @db.Timestamptz(3)
  rejectedBy  String?
  rejectedAt  DateTime?            @db.Timestamptz(3)
  revokedBy   String?
  revokedAt   DateTime?            @db.Timestamptz(3)
  startedAt   DateTime?            @db.Timestamptz(3)
  endedAt     DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  athlete     User                 @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@index([schoolId, status])
  @@index([athleteId, status])
}

/// PENDING requires startedAt NULL, enforced by the CHECK in migration 0011.
model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  userId    String
  status    MembershipStatus @default(PENDING)
  startedAt DateTime?        @db.Timestamptz(3)
  endedAt   DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles     SchoolMembershipRole[]

  @@index([schoolId, status])
  @@index([userId, status])
}

model SchoolMembershipRole {
  id           String           @id @default(cuid())
  membershipId String
  role         SchoolRole
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  membership   SchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([membershipId, role])
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  cpfEncrypted            String?
  cpfHash                 String?   @unique
  phoneE164               String?
  heightCm                Int?
  weightKg                Decimal?  @db.Decimal(5, 2)
  onboardingCompletedAt   DateTime?
  activityLayoutOrder     Json?
  dashboardLayoutOrder    Json?
  integrationsLayoutOrder Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(cuid())
  userId     String   @unique
  postalCode String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WearableConnection {
  id                         String                   @id @default(cuid())
  userId                     String
  provider                   WearableProvider
  externalAccountId          String?
  status                     ConnectionStatus         @default(DISCONNECTED)
  capabilities               String[]
  label                      String?
  lastSyncAt                 DateTime?
  lastSyncStatus             String?
  lastErrorCode              String?
  lastProbeAt                DateTime?
  nextProbeAt                DateTime?
  lastSeenActivityExternalId String?
  lastProbeStatus            String?
  lastProbeErrorCode         String?
  lastProbeFailureCount      Int                      @default(0)
  lastEventAt                DateTime?
  lastSuccessAt              DateTime?
  lastErrorAt                DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secrets                    WearableSecret[]
  activities                 Activity[]
  stravaDetails              StravaConnectionDetails?

  @@unique([userId, provider])
  @@index([provider, nextProbeAt])
}

model WearableSecret {
  id                   String             @id @default(cuid())
  wearableConnectionId String
  secretType           SecretType
  ciphertext           String
  nonce                String
  authTag              String
  keyVersion           Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)

  @@unique([wearableConnectionId, secretType])
}

model Activity {
  id                   String             @id @default(cuid())
  userId               String
  wearableConnectionId String
  externalId           String
  provider             WearableProvider
  sportType            String
  providerSportType    String?
  name                 String?
  startedAt            DateTime
  endedAt              DateTime?
  durationSeconds      Int?
  movingSeconds        Int?
  distanceMeters       Float?
  calories             Int?
  averageHeartRate     Int?
  maxHeartRate         Int?
  averagePace          Float?
  averageSpeed         Float?
  maxSpeed             Float?
  elevationGain        Float?
  averageCadence       Float?
  averagePower         Float?
  maxPower             Float?
  timezone             String?
  metrics              Json?
  rawPayload           Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, userId])
  @@index([userId, startedAt])
}

model WhatsAppIdentity {
  id          String    @id @default(cuid())
  userId      String    @unique
  phoneE164   String
  externalJid String?
  verifiedAt  DateTime?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsAppActivationToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  phoneE164    String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  postActivityReport Boolean  @default(true)
  dailySummary       Boolean  @default(false)
  weeklySummary      Boolean  @default(false)
  reportTime         String?
  timezone           String?  @default("America/Sao_Paulo")
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageDelivery {
  id                String         @id @default(cuid())
  userId            String
  channel           Channel
  type              String
  provider          String
  externalMessageId String?
  status            DeliveryStatus @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorCode         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model IntegrationEvent {
  id          String    @id @default(cuid())
  userId      String?
  provider    String
  eventType   String
  externalId  String?
  payload     Json?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, eventType, externalId])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  scope     String
  key       String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
  @@index([resetAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String
  action       String
  targetUserId String?
  entityType   String?
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  actor        User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Strava-specific models
// Provider-specific persistence for the modular Strava integration. Canonical
// activities live in the shared `Activity` model; the models below hold data
// that only makes sense for Strava (OAuth connection details, webhook lifecycle
// and short-lived caches).
// Note: StravaStreamCache is intentionally deferred — it will only be added if
// activity streams turn out to be necessary (see design section 3).
// ---------------------------------------------------------------------------

model StravaConnectionDetails {
  id                   String             @id @default(cuid())
  wearableConnectionId String             @unique
  athleteId            String             @unique
  scopes               String[]
  accessTokenExpiresAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  wearableConnection   WearableConnection @relation(fields: [wearableConnectionId], references: [id], onDelete: Cascade)
}

model StravaWebhookSubscription {
  id                     String   @id @default(cuid())
  externalSubscriptionId String   @unique
  callbackUrl            String
  status                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model StravaWebhookEvent {
  id               String    @id @default(cuid())
  ownerAthleteId   String?
  objectType       String
  objectId         String
  aspectType       String
  eventTime        DateTime
  payload          Json?
  processingStatus String // PENDING | PROCESSED | FAILED
  attemptCount     Int       @default(0)
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  expiresAt        DateTime

  @@index([processingStatus, receivedAt])
  @@index([ownerAthleteId, receivedAt])
}

model StravaActivityCache {
  id                   String    @id @default(cuid())
  wearableConnectionId String
  stravaActivityId     String
  sportType            String?
  startedAt            DateTime?
  payload              Json
  fetchedAt            DateTime
  expiresAt            DateTime

  @@unique([wearableConnectionId, stravaActivityId])
  @@index([expiresAt])
}
